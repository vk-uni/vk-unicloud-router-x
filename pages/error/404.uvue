<template>
  <view class="error-page" :style="{ minHeight: windowHeight + 'px' }">
    <view class="error-content">
      <text class="status-code">404</text>
      <text class="title">页面走丢了...</text>
      <text class="desc">你访问的页面不存在或已被移除</text>
      <image class="empty-image" src="./static/404.png" mode="aspectFit"></image>
      <button class="home-btn" hover-class="home-btn-hover" @click="backHome">返回首页</button>
    </view>
  </view>
</template>

<script setup>
  import vk from '@/uni_modules/vk-unicloud';

  const windowHeight = ref(uni.getWindowInfo().windowHeight);

  onReady(() => {
    windowHeight.value = uni.getWindowInfo().windowHeight;
  });

  onResize((options) => {
    windowHeight.value = options.size.windowHeight;
  });

  const backHome = () => {
    vk.navigateToHome();
  };
</script>

