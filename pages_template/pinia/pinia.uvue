<template>
  <view class="pinia-page">
    <scroll-view class="pinia-scroll" direction="vertical">
      <view class="demo-content">
        <view class="demo-hero">
          <text class="eyebrow">STATE / PINIA</text>
          <text class="hero-title">两种写法，一份状态</text>
          <text class="hero-description">试着修改下面的数据，观察 Pinia 与 vk API 的结果同步变化。</text>
          <view class="stats-row">
            <view class="stat">
              <text class="stat-value">{{ demoStore.count }}</text>
              <text class="stat-label">当前计数</text>
            </view>
            <view class="stat">
              <text class="stat-value">{{ demoStore.doubleCount }}</text>
              <text class="stat-label">计算属性 × 2</text>
            </view>
            <view class="stat">
              <text class="stat-value">{{ demoStore.completedCount }}/{{ demoStore.items.length }}</text>
              <text class="stat-label">清单已完成</text>
            </view>
          </view>
        </view>

        <view class="demo-card">
          <text class="section-number">01 / 基础状态</text>
          <text class="section-title">从任一入口修改</text>
          <view class="comparison-row">
            <view class="comparison-box comparison-first">
              <text class="small-label">原生 Pinia</text>
              <text class="comparison-value">{{ demoStore.count }}</text>
              <text class="code-inline">demoStore.count</text>
            </view>
            <view class="comparison-box">
              <text class="small-label">vk.getVuex</text>
              <text class="comparison-value">{{ vkCount }}</text>
              <text class="code-inline">$demo.count</text>
            </view>
          </view>
          <view class="button-row">
            <button :hover-class="(actionLoading) ? 'none' : 'demo-button-hover'" class="demo-button primary button-first" :class="{ 'demo-button-disabled': actionLoading }" @click="incrementWithPinia">Pinia +1</button>
            <button :hover-class="(actionLoading) ? 'none' : 'demo-button-hover'" class="demo-button secondary" :class="{ 'demo-button-disabled': actionLoading }" @click="incrementWithVk">vk.setVuex +1</button>
          </view>
          <button :hover-class="(actionLoading) ? 'none' : 'demo-button-hover'" class="demo-button outline block-button" :loading="actionLoading" :class="{ 'demo-button-disabled': actionLoading }" @click="runAsyncAction">执行异步 action +1</button>
          <text class="code-block" selectable>{{ counterExample }}</text>
          <text class="hint">上方的两倍计数由 computed 自动计算。异步 action 等待 600ms 后更新同一状态。</text>
        </view>

        <view class="demo-card">
          <text class="section-number">02 / 嵌套对象</text>
          <text class="section-title">修改演示昵称</text>
          <text class="body-text">当前昵称：{{ demoStore.profile.nickname }}</text>
          <text class="muted-text">vk 读取：{{ vkProfile.nickname }} · {{ vkProfile.city }}</text>
          <input placeholder-class="demo-placeholder" class="demo-input" v-model="nickname" :maxlength="20" placeholder="输入一个演示昵称" :disabled="actionLoading" />
          <view class="button-row">
            <button :hover-class="(actionLoading) ? 'none' : 'demo-button-hover'" class="demo-button primary button-first" :class="{ 'demo-button-disabled': actionLoading }" @click="saveNicknameWithPinia">Pinia 保存</button>
            <button :hover-class="(actionLoading) ? 'none' : 'demo-button-hover'" class="demo-button secondary" :class="{ 'demo-button-disabled': actionLoading }" @click="saveNicknameWithVk">vk 保存</button>
          </view>
          <text class="code-block" selectable>{{ profileExample }}</text>
          <text class="hint">这里只修改 $demo.profile，不会修改真实账号资料。</text>
        </view>

        <view class="demo-card">
          <text class="section-number">03 / 数组与 ACTION</text>
          <text class="section-title">一份小清单</text>
          <text class="muted-text">已完成 {{ demoStore.completedCount }} 项，共 {{ demoStore.items.length }} 项</text>
          <input placeholder-class="demo-placeholder" class="demo-input" v-model="itemTitle" :maxlength="40" placeholder="添加一条演示事项" :disabled="actionLoading" />
          <view class="button-row">
            <button :hover-class="(actionLoading) ? 'none' : 'demo-button-hover'" class="demo-button primary button-first" :class="{ 'demo-button-disabled': actionLoading }" @click="addWithPinia">action 添加</button>
            <button :hover-class="(actionLoading) ? 'none' : 'demo-button-hover'" class="demo-button secondary" :class="{ 'demo-button-disabled': actionLoading }" @click="addWithVk">vk 添加</button>
          </view>
          <view v-if="demoStore.items.length === 0" class="empty-list">
            <text class="muted-text">清单是空的，添加一项试试。</text>
          </view>
          <view v-for="item in demoStore.items" :key="item.id" class="list-item">
            <button :hover-class="(actionLoading) ? 'none' : 'demo-button-hover'" class="check-button" :class="{ 'check-button-done': item.done, 'demo-button-disabled': actionLoading }" @click="!actionLoading && demoStore.toggleItem(item.id)">
              {{ item.done ? '✓' : '○' }}
            </button>
            <text class="item-title" :class="{ 'item-title-done': item.done }">{{ item.title }}</text>
            <button :hover-class="(actionLoading) ? 'none' : 'demo-button-hover'" class="remove-button" :class="{ 'demo-button-disabled': actionLoading }" @click="removeWithVk(item.id)">删除</button>
          </view>
          <text class="code-block" selectable>{{ itemsExample }}</text>
          <text class="hint">勾选通过 Pinia action 更新；删除通过 vk.setVuex 写回数组。</text>
        </view>

        <view class="demo-card">
          <text class="section-number">04 / 数据副本</text>
          <text class="section-title">读取不等于绑定</text>
          <text class="body-text">vk.getVuex 返回的是一份数据副本。修改这份副本不会改变原状态。</text>
          <button :hover-class="(actionLoading) ? 'none' : 'demo-button-hover'" class="demo-button outline block-button" :class="{ 'demo-button-disabled': actionLoading }" @click="changeSnapshot">获取副本，并只修改副本昵称</button>
          <view class="snapshot-box">
            <text class="body-text">原状态：{{ demoStore.profile.nickname }}</text>
            <text class="muted-text">副本：{{ snapshotName }}</text>
          </view>
          <text class="code-block" selectable>{{ snapshotExample }}</text>
          <text class="hint">需要页面持续同步时，用 computed(() => vk.getVuex(...))；需要更新状态时，用 vk.setVuex(...)。</text>
        </view>

        <view class="demo-card">
          <text class="section-number">05 / 共享与持久化</text>
          <text class="section-title">离开页面，数据仍在</text>
          <text class="body-text">到下一页修改计数或昵称，再返回这里。刷新 Web 或重启 App，也会恢复上次的演示数据。</text>
          <button :hover-class="(actionLoading) ? 'none' : 'demo-button-hover'" class="demo-button primary block-button" :class="{ 'demo-button-disabled': actionLoading }" @click="openSyncPage">打开跨页状态演示</button>
          <button :hover-class="(actionLoading) ? 'none' : 'demo-button-hover'" class="demo-button outline block-button" :class="{ 'demo-button-disabled': actionLoading }" @click="resetDemo">重置演示数据</button>
          <text class="hint">持久化由项目现有 store 入口统一处理。重置只影响 $demo 模块。</text>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup>
  import { computed, ref } from 'vue';
  import vk from '@/uni_modules/vk-unicloud';
  import { useDemoStore } from '@/store/modules/$demo.js';

  const demoStore = useDemoStore();
  // 在 computed 内读取，让页面跟踪底层 Pinia 状态，避免只保留一次性的快照。
  const vkCount = computed(() => vk.getVuex('$demo.count', 0));
  const vkProfile = computed(() => vk.getVuex('$demo.profile'));
  const nickname = ref(demoStore.profile.nickname);
  const itemTitle = ref('');
  const actionLoading = ref(false);
  const snapshotName = ref('尚未获取');

  const counterExample = "demoStore.count += 1;\nvk.setVuex('$demo.count', vk.getVuex('$demo.count') + 1);\nawait demoStore.incrementLater();";
  const profileExample = "demoStore.profile.nickname = nickname;\nvk.setVuex('$demo.profile.nickname', nickname);";
  const itemsExample = "demoStore.addItem(title);\nconst items = vk.getVuex('$demo.items');\n// 修改副本后，将数组写回\nvk.setVuex('$demo.items', items);";
  const snapshotExample = "const snapshot = vk.getVuex('$demo.profile');\nsnapshot.nickname = '只修改副本';\n// demoStore.profile.nickname 保持原值";

  onShow(() => {
    nickname.value = demoStore.profile.nickname;
  });

  function incrementWithPinia() {
    if (actionLoading.value) return;
    demoStore.count += 1;
  }

  function incrementWithVk() {
    if (actionLoading.value) return;
    vk.setVuex('$demo.count', vk.getVuex('$demo.count') + 1);
  }

  async function runAsyncAction() {
    if (actionLoading.value) return;
    actionLoading.value = true;
    try {
      await demoStore.incrementLater();
    } finally {
      actionLoading.value = false;
    }
  }

  function getNickname() {
    const value = nickname.value.trim();
    if (vk.pubfn.isNull(value)) vk.toast('请输入演示昵称');
    return value;
  }

  function saveNicknameWithPinia() {
    if (actionLoading.value) return;
    const value = getNickname();
    if (vk.pubfn.isNull(value)) return;
    demoStore.profile.nickname = value;
    vk.toast('已通过 Pinia 保存');
  }

  function saveNicknameWithVk() {
    if (actionLoading.value) return;
    const value = getNickname();
    if (vk.pubfn.isNull(value)) return;
    vk.setVuex('$demo.profile.nickname', value);
    vk.toast('已通过 vk 保存');
  }

  function getItemTitle() {
    const value = itemTitle.value.trim();
    if (vk.pubfn.isNull(value)) vk.toast('请输入演示事项');
    return value;
  }

  function addWithPinia() {
    if (actionLoading.value) return;
    const title = getItemTitle();
    if (vk.pubfn.isNull(title)) return;
    demoStore.addItem(title);
    itemTitle.value = '';
  }

  function addWithVk() {
    if (actionLoading.value) return;
    const title = getItemTitle();
    if (vk.pubfn.isNull(title)) return;
    const items = vk.getVuex('$demo.items');
    const id = items.reduce((maximum, item) => Math.max(maximum, item.id), 0) + 1;
    items.push({ id, title, done: false });
    vk.setVuex('$demo.items', items);
    itemTitle.value = '';
  }

  function removeWithVk(id) {
    if (actionLoading.value) return;
    const items = vk.getVuex('$demo.items');
    vk.setVuex(
      '$demo.items',
      items.filter((item) => item.id !== id)
    );
  }

  function changeSnapshot() {
    if (actionLoading.value) return;
    const snapshot = vk.getVuex('$demo.profile');
    snapshot.nickname = '只修改副本';
    snapshotName.value = snapshot.nickname;
  }

  function openSyncPage() {
    if (actionLoading.value) return;
    vk.navigateTo('/pages_template/pinia/sync');
  }

  function resetDemo() {
    if (actionLoading.value) return;
    demoStore.resetDemo();
    nickname.value = demoStore.profile.nickname;
    itemTitle.value = '';
    snapshotName.value = '尚未获取';
    vk.toast('演示数据已重置');
  }
</script>

<style>
  @import './pinia.css';
</style>
