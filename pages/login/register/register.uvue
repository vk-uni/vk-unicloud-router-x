<template>
  <view class="auth-page">
    <scroll-view class="auth-scroll" direction="vertical" :show-scrollbar="false">
      <view class="auth-content" :style="contentStyle">
        <view class="auth-header">
          <image class="auth-logo" src="@/static/logo.png" mode="aspectFit" />
          <view class="auth-heading">
            <text class="auth-title">注册账号</text>
            <text class="auth-subtitle">使用手机号创建新账号</text>
          </view>
        </view>

        <view class="auth-form">
          <view class="auth-field">
            <text class="auth-label">手机号</text>
            <view class="auth-input-row">
              <text class="auth-country-code">+86</text>
              <view class="auth-input-divider"></view>
              <input
                v-model="form.mobile"
                class="auth-input"
                type="number"
                :maxlength="11"
                :disabled="requestState.submitting"
                placeholder="请输入手机号"
                placeholder-class="auth-placeholder"
              />
            </view>
          </view>
          <view class="auth-field">
            <text class="auth-label">验证码</text>
            <view class="auth-input-row">
              <input
                v-model="form.code"
                class="auth-input"
                type="number"
                :maxlength="6"
                :disabled="requestState.submitting"
                placeholder="请输入验证码"
                placeholder-class="auth-placeholder"
              />
              <view class="auth-code">
                <view v-show="!requestState.submitting">
                  <vk-data-verification-code
                    :seconds="60"
                    :mobile="form.mobile.trim()"
                    type="register"
                    :keep-running="true"
                    unique-key="vk-client-x-register"
                    change-text="X秒后重试"
                    custom-style="font-size: 13px; color: var(--main-color, #111111); background-color: #f4f4f4; border-radius: 18px; padding: 5px 12px;"
                  ></vk-data-verification-code>
                </view>
                <text v-if="requestState.submitting" class="auth-code-disabled">获取验证码</text>
              </view>
            </view>
          </view>
          <view class="auth-field">
            <text class="auth-label">设置密码</text>
            <view class="auth-input-row">
              <input
                v-model="form.password"
                class="auth-input"
                :password="!showPassword"
                :maxlength="18"
                :disabled="requestState.submitting"
                placeholder="请设置登录密码"
                placeholder-class="auth-placeholder"
              />
              <view
                class="auth-icon-button"
                :hover-class="requestState.submitting ? 'none' : 'auth-button-hover'"
                @click="!requestState.submitting && (showPassword = !showPassword)"
              >
                <auth-icon :name="showPassword ? 'eye-off' : 'eye'" :size="22" />
              </view>
            </view>
          </view>
          <view class="auth-field auth-field-last">
            <text class="auth-label">确认密码</text>
            <view class="auth-input-row">
              <input
                v-model="form.password2"
                class="auth-input"
                :password="!showPassword2"
                :maxlength="18"
                :disabled="requestState.submitting"
                confirm-type="done"
                placeholder="请再次输入密码"
                placeholder-class="auth-placeholder"
                @confirm="register"
              />
              <view
                class="auth-icon-button"
                :hover-class="requestState.submitting ? 'none' : 'auth-button-hover'"
                @click="!requestState.submitting && (showPassword2 = !showPassword2)"
              >
                <auth-icon :name="showPassword2 ? 'eye-off' : 'eye'" :size="22" />
              </view>
            </view>
          </view>
          <view class="auth-actions">
            <text v-if="errorMessage.length > 0" class="auth-error">{{ errorMessage }}</text>
            <button
              class="auth-submit"
              :class="{ 'auth-button-disabled': requestState.submitting }"
              type="primary"
              :hover-class="requestState.submitting ? 'none' : 'auth-button-hover'"
              :loading="requestState.submitting"
              @click="register"
            >
              注册账号
            </button>
          </view>
        </view>

        <view class="auth-footer">
          <text class="auth-muted">已有账号？</text>
          <text class="auth-link" @click="backToLogin">立即登录</text>
        </view>
        <view class="auth-agreement-area"><auth-agreement v-model="agreed" :disabled="requestState.submitting" /></view>
      </view>
    </scroll-view>
  </view>
</template>

<script setup>
  import { getCurrentInstance, reactive, ref } from 'vue';
  // 引入 vk 对象
  import vk from '@/uni_modules/vk-unicloud';
  // 引入验证码组件
  import VkDataVerificationCode from '@/uni_modules/vk-unicloud/components/vk-data-verification-code/vk-data-verification-code.uvue';
  import AuthIcon from '../components/auth-icon.uvue';
  import AuthAgreement from '../components/auth-agreement.uvue';
  import { captureLoginOptions, finishLogin, getLoginQuery, getRequestMessage, validateMobilePassword, useAuthLayout } from '../utils.js';

  const pageInstance = getCurrentInstance()?.proxy;
  const form = reactive({ mobile: '', code: '', password: '', password2: '' });
  const requestState = reactive({ submitting: false });
  const errorMessage = ref('');
  const showPassword = ref(false);
  const showPassword2 = ref(false);
  const agreed = ref(false);
  const { contentStyle } = useAuthLayout();
  let pageOptions = {};
  let disposed = false;

  async function register() {
    if (requestState.submitting) return;
    if (!agreed.value) {
      vk.toast('请先阅读并同意用户协议和隐私政策', 'none');
      return;
    }
    if (!validateMobilePassword(form)) return;
    errorMessage.value = '';
    requestState.submitting = true;
    try {
      const res = await vk.userCenter.loginBySms({
        loading: { that: requestState, name: 'submitting' },
        data: {
          mobile: form.mobile.trim(),
          code: form.code.trim(),
          password: form.password,
          type: 'register', // type: 'register' 表示注册。
        },
      });
      // 离开页面后，不再处理成功提示和跳转。
      if (disposed || vk.pubfn.isNull(res)) return;
      form.password = '';
      form.password2 = '';
      form.code = '';
      vk.toast('注册成功');
      finishLogin(pageOptions, pageInstance);
    } catch (error) {
      errorMessage.value = getRequestMessage(error, '注册失败，请稍后重试');
    } finally {
      requestState.submitting = false;
    }
  }

  // 优先返回已有登录页，避免重复入栈。
  function backToLogin() {
    if (requestState.submitting) return;
    const pages = getCurrentPages();
    const previousPage = pages[pages.length - 2];
    if (previousPage?.route === 'pages/login/index/index') {
      vk.navigateBack();
    } else {
      vk.redirectTo('/pages/login/index/index' + getLoginQuery(pageOptions));
    }
  }

  // 监听 - 页面每次【加载时】执行(如：前进)
  onLoad((options) => {
    // 保留登录后的回跳目标。
    pageOptions = captureLoginOptions(options);
  });

  // 监听 - 页面每次【卸载时】（一般用于取消页面上的监听器）
  onUnload(() => {
    disposed = true;
  });
</script>

<style>
  @import '../css/main.css';
</style>
